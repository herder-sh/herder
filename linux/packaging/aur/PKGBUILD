# Maintainer: herder <https://github.com/herder-sh/herder>
#
# Kept in the herder repo (linux/packaging/aur); the release workflow sets pkgver and the
# checksum for each tag and pushes this file and its .SRCINFO to the AUR.

pkgname=herder-gtk
_name=herder
pkgver=0.25.0
pkgrel=1
pkgdesc='Watch and steer coding agents across your machines (GTK app)'
arch=('x86_64' 'aarch64')
url='https://github.com/herder-sh/herder'
license=('Apache-2.0')
depends=('gdk-pixbuf2' 'glib2' 'glibc' 'graphene' 'gtk4' 'hicolor-icon-theme' 'libadwaita' 'libgcc' 'pango')
makedepends=('cargo')
# makepkg's -flto makes ring's C objects GCC LTO bitcode, which rust-lld cannot link.
options=('!lto')
source=("$_name-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('50f8e2fe116df732f2bfe1b145d6c163f67ee5833aae954c701d0e09ebd0c813')

prepare() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p herder-gtk
}

check() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The window tests need a display; gtk4 ships the broadway backend, which needs none.
  gtk4-broadwayd :17 &
  local broadwayd=$!
  GDK_BACKEND=broadway BROADWAY_DISPLAY=:17 cargo test --frozen -p herder-gtk || {
    kill "$broadwayd"
    return 1
  }
  kill "$broadwayd"
}

package() {
  cd "$_name-$pkgver"
  install -Dm755 target/release/herder-gtk -t "$pkgdir/usr/bin"
  install -Dm644 linux/data/sh.herder.Herder.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 linux/data/icons/hicolor/scalable/apps/sh.herder.Herder.svg \
    -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  # The AppStream metadata arrives with the Flatpak; older tags lack it.
  if [[ -f linux/data/sh.herder.Herder.metainfo.xml ]]; then
    install -Dm644 linux/data/sh.herder.Herder.metainfo.xml -t "$pkgdir/usr/share/metainfo"
  fi
}
