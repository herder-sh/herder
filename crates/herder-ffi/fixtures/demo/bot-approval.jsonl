# A Codex turn, started from Slack through the acme-ops bot, that waits for the user to allow
# rolling the staging deploy back.
{"emit": {"type": "turn_started", "turn_id": "$turn"}}
{"emit": {"type": "model_changed", "model": "gpt-6.1-sol"}}
{"emit": {"type": "item_completed", "item": {"id": "$turn-1", "turn_id": "$turn", "body": {"type": "tool_call", "name": "shell", "input": {"command": "kubectl rollout history deployment/api -n staging"}}}}}
{"emit": {"type": "item_completed", "item": {"id": "$turn-2", "turn_id": "$turn", "body": {"type": "tool_result", "call_id": "$turn-1", "output": "REVISION  CHANGE-CAUSE\n41        api 2.31.0\n42        api 2.32.0", "is_error": false}}}}
{"emit": {"type": "item_completed", "item": {"id": "$turn-3", "turn_id": "$turn", "body": {"type": "assistant_message", "text": "Revision 42 (api 2.32.0) went out an hour ago and the 5xx rate rose with it. Rolling back to 41."}}}}
{"emit": {"type": "item_completed", "item": {"id": "$turn-4", "turn_id": "$turn", "body": {"type": "tool_call", "name": "shell", "input": {"command": "kubectl rollout undo deployment/api -n staging --to-revision=41"}}}}}
{"emit": {"type": "approval_requested", "approval_id": "$turn-approval", "turn_id": "$turn", "tool_call_id": "$turn-4", "summary": "Run kubectl rollout undo deployment/api -n staging --to-revision=41"}}
"hold"
