# A Claude turn that asks which browsers to add, several of which may be picked.
{"emit": {"type": "turn_started", "turn_id": "$turn"}}
{"emit": {"type": "item_completed", "item": {"id": "$turn-1", "turn_id": "$turn", "body": {"type": "tool_call", "name": "Read", "input": {"file_path": "playwright.config.ts"}}}}}
{"emit": {"type": "item_completed", "item": {"id": "$turn-2", "turn_id": "$turn", "body": {"type": "tool_result", "call_id": "$turn-1", "output": "projects: [{ name: 'chromium', use: devices['Desktop Chrome'] }]", "is_error": false}}}}
{"emit": {"type": "item_completed", "item": {"id": "$turn-3", "turn_id": "$turn", "body": {"type": "assistant_message", "text": "The checkout suite only runs in Chromium today. Each browser I add costs about four minutes of CI."}}}}
{"emit": {"type": "item_completed", "item": {"id": "$turn-4", "turn_id": "$turn", "body": {"type": "tool_call", "name": "AskUserQuestion", "input": {"questions": [{"question": "Which browsers should the checkout suite also run in?", "header": "Browsers", "options": [{"label": "WebKit (Recommended)", "description": "Safari's engine, where most checkout bugs were reported"}, {"label": "Firefox", "description": "Desktop Firefox"}, {"label": "Mobile Safari", "description": "iPhone viewport on WebKit"}, {"label": "Mobile Chrome", "description": "Pixel viewport on Chromium"}], "multiSelect": true}]}}}}}
{"emit": {"type": "question_asked", "question_id": "$turn-question", "turn_id": "$turn", "text": "Which browsers should the checkout suite also run in?\n\n- **WebKit (Recommended)**: Safari's engine, where most checkout bugs were reported\n- **Firefox**: Desktop Firefox\n- **Mobile Safari**: iPhone viewport on WebKit\n- **Mobile Chrome**: Pixel viewport on Chromium", "choices": ["WebKit (Recommended)", "Firefox", "Mobile Safari", "Mobile Chrome"], "multi_select": true}}
"hold"
