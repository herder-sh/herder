{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientMessage",
  "description": "A client-to-daemon message.",
  "oneOf": [
    {
      "description": "First message on every connection.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        }
      },
      "$ref": "#/$defs/ClientHello",
      "required": [
        "type"
      ]
    },
    {
      "description": "Stream a session's events after a cursor, then live; replaces any existing subscription.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "subscribe"
        }
      },
      "$ref": "#/$defs/Cursor",
      "required": [
        "type"
      ]
    },
    {
      "description": "Stop streaming a session.",
      "type": "object",
      "properties": {
        "session_id": {
          "description": "Session to stop.",
          "$ref": "#/$defs/SessionId"
        },
        "type": {
          "type": "string",
          "const": "unsubscribe"
        }
      },
      "required": [
        "type",
        "session_id"
      ]
    },
    {
      "description": "Ask the daemon to change something.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "command"
        }
      },
      "$ref": "#/$defs/Command",
      "required": [
        "type"
      ]
    },
    {
      "description": "A barrier: the daemon answers `synced` with the same token once it handled every\nmessage sent before this one, so the lists sent after hello and the replay of every\nearlier subscription arrive before the answer.",
      "type": "object",
      "properties": {
        "token": {
          "description": "Chosen by the client to match the answer.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "sync"
        }
      },
      "required": [
        "type",
        "token"
      ]
    }
  ],
  "$defs": {
    "AccountId": {
      "description": "Identifies a provider account on a host; the name its owner gave it, opaque to receivers.",
      "type": "string"
    },
    "Answer": {
      "description": "An answer to a question.",
      "oneOf": [
        {
          "description": "A free-text answer.",
          "type": "object",
          "properties": {
            "text": {
              "description": "Answer text.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "description": "One of the question's choices.",
          "type": "object",
          "properties": {
            "index": {
              "description": "Position of the choice in the question's `choices`, from 0.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "choice"
            }
          },
          "required": [
            "type",
            "index"
          ]
        }
      ]
    },
    "ApprovalDecision": {
      "description": "An answer to an approval request.",
      "oneOf": [
        {
          "description": "Run the tool call once.",
          "type": "string",
          "const": "allow"
        },
        {
          "description": "Refuse the tool call.",
          "type": "string",
          "const": "deny"
        }
      ]
    },
    "ApprovalId": {
      "description": "Identifies an approval request within a session; a ULID string, opaque to receivers.",
      "type": "string"
    },
    "AttachmentId": {
      "description": "Identifies an image a prompt carried, within its session; a ULID string, opaque.",
      "type": "string"
    },
    "Bytes": {
      "description": "Raw bytes, encoded as a standard padded base64 string.",
      "type": "string",
      "contentEncoding": "base64"
    },
    "ClientHello": {
      "description": "Opening message of a client connection.",
      "type": "object",
      "properties": {
        "client": {
          "description": "Client name and version, for logs, e.g. `herder-tui/0.1.0`.",
          "type": "string"
        },
        "pairing_code": {
          "description": "One-time code from `herder pair`, sent by a device that is not paired yet; ignored once\nit is.",
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_version": {
          "description": "Must equal the daemon's [`crate::PROTOCOL_VERSION`].",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "resume": {
          "description": "Subscriptions to restore, each resuming after its last seen event.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cursor"
          }
        }
      },
      "required": [
        "protocol_version",
        "client",
        "resume"
      ]
    },
    "Command": {
      "description": "A request to change state, applied at most once per `id`.",
      "type": "object",
      "properties": {
        "body": {
          "description": "What to do.",
          "$ref": "#/$defs/CommandBody"
        },
        "id": {
          "description": "Idempotency key: a resend with the same id is answered without being applied again.",
          "$ref": "#/$defs/CommandId"
        }
      },
      "required": [
        "id",
        "body"
      ]
    },
    "CommandBody": {
      "description": "What a command asks for.",
      "oneOf": [
        {
          "description": "Create a session on a new worktree and branch of a repository, named by exactly one of\n`repo` and `project_id`.",
          "type": "object",
          "properties": {
            "account_id": {
              "description": "Account to run on. When absent: the available account of `provider` with the most\nroom left in its usage windows, when `provider` is set; else the project's\n`default_account`, which then must be set.",
              "anyOf": [
                {
                  "$ref": "#/$defs/AccountId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "branch": {
              "description": "Branch to create; the daemon picks a name when absent.",
              "type": [
                "string",
                "null"
              ]
            },
            "failover_pin": {
              "description": "Whether the session stays on its account when it hits a limit instead of rotating\nto another account of its provider; the daemon's `[failover] pin` when absent.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "max_children": {
              "description": "Most live children the session may have as a task's primary; the daemon's\n`[tasks] max_children` when absent.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "model": {
              "description": "Model to use; the provider's default when absent.",
              "type": [
                "string",
                "null"
              ]
            },
            "permission_mode": {
              "description": "Starting permission mode; the project's `default_permission_mode` when absent, else\n`ask`.",
              "anyOf": [
                {
                  "$ref": "#/$defs/PermissionMode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "project_id": {
              "description": "Project to work on, in its first clone on the host.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ProjectId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "provider": {
              "description": "Provider to run on, when `account_id` is absent; with `account_id`, it must be that\naccount's provider.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Provider"
                },
                {
                  "type": "null"
                }
              ]
            },
            "repo": {
              "description": "Absolute path of the repository on the host.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "create_session"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Archive a session: remove its worktree, keep its branches, and make it read-only.",
          "type": "object",
          "properties": {
            "force": {
              "description": "Remove the worktree even when it has uncommitted or untracked changes.",
              "type": "boolean"
            },
            "session_id": {
              "description": "Target session.",
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "type": "string",
              "const": "archive_session"
            }
          },
          "required": [
            "type",
            "session_id",
            "force"
          ]
        },
        {
          "description": "Bring an archived session back: recreate its worktree, at the path it had, on the\nsession's own branch as archive kept it, and make the session writable again.",
          "type": "object",
          "properties": {
            "session_id": {
              "description": "Target session.",
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "type": "string",
              "const": "unarchive_session"
            }
          },
          "required": [
            "type",
            "session_id"
          ]
        },
        {
          "description": "Start a turn with a prompt.",
          "type": "object",
          "properties": {
            "images": {
              "description": "Images for the agent to see with the text, together at most\n[`crate::MAX_PROMPT_IMAGE_BYTES`]; a provider that cannot take images refuses them\nas `unsupported`.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Image"
              }
            },
            "session_id": {
              "description": "Target session.",
              "$ref": "#/$defs/SessionId"
            },
            "text": {
              "description": "Prompt text.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "send_prompt"
            }
          },
          "required": [
            "type",
            "session_id",
            "text"
          ]
        },
        {
          "description": "Fetch the bytes of an image a prompt of the session carried; answered with\n`attachment`. It changes nothing, so a resend is answered afresh.",
          "type": "object",
          "properties": {
            "attachment_id": {
              "description": "The image, as the prompt's `user_message` names it.",
              "$ref": "#/$defs/AttachmentId"
            },
            "session_id": {
              "description": "Session whose prompt carried it.",
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "type": "string",
              "const": "get_attachment"
            }
          },
          "required": [
            "type",
            "session_id",
            "attachment_id"
          ]
        },
        {
          "description": "Stop the running turn.",
          "type": "object",
          "properties": {
            "session_id": {
              "description": "Target session.",
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "type": "string",
              "const": "interrupt"
            }
          },
          "required": [
            "type",
            "session_id"
          ]
        },
        {
          "description": "Change the model within the current provider.",
          "type": "object",
          "properties": {
            "model": {
              "description": "New model, in the provider's own naming.",
              "type": "string"
            },
            "session_id": {
              "description": "Target session.",
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "type": "string",
              "const": "set_model"
            }
          },
          "required": [
            "type",
            "session_id",
            "model"
          ]
        },
        {
          "description": "Change the permission mode.",
          "type": "object",
          "properties": {
            "mode": {
              "description": "New permission mode.",
              "$ref": "#/$defs/PermissionMode"
            },
            "session_id": {
              "description": "Target session.",
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "type": "string",
              "const": "set_permission_mode"
            }
          },
          "required": [
            "type",
            "session_id",
            "mode"
          ]
        },
        {
          "description": "Answer a pending approval request as the user, whoever it is routed to.",
          "type": "object",
          "properties": {
            "approval_id": {
              "description": "Request to answer.",
              "$ref": "#/$defs/ApprovalId"
            },
            "decision": {
              "description": "The answer.",
              "$ref": "#/$defs/ApprovalDecision"
            },
            "session_id": {
              "description": "Target session.",
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "type": "string",
              "const": "answer_approval"
            }
          },
          "required": [
            "type",
            "session_id",
            "approval_id",
            "decision"
          ]
        },
        {
          "description": "Answer a pending question as the user, whoever it is routed to.",
          "type": "object",
          "properties": {
            "answer": {
              "description": "The answer.",
              "$ref": "#/$defs/Answer"
            },
            "question_id": {
              "description": "Question to answer.",
              "$ref": "#/$defs/QuestionId"
            },
            "session_id": {
              "description": "Session that asked.",
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "type": "string",
              "const": "answer_question"
            }
          },
          "required": [
            "type",
            "session_id",
            "question_id",
            "answer"
          ]
        },
        {
          "description": "Move to another account of the same provider.",
          "type": "object",
          "properties": {
            "account_id": {
              "description": "New account.",
              "$ref": "#/$defs/AccountId"
            },
            "session_id": {
              "description": "Target session.",
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "type": "string",
              "const": "switch_account"
            }
          },
          "required": [
            "type",
            "session_id",
            "account_id"
          ]
        },
        {
          "description": "Move to an account of another provider, replaying the transcript.",
          "type": "object",
          "properties": {
            "account_id": {
              "description": "New account; its provider is the new provider.",
              "$ref": "#/$defs/AccountId"
            },
            "model": {
              "description": "Model to use; the new provider's default when absent.",
              "type": [
                "string",
                "null"
              ]
            },
            "session_id": {
              "description": "Target session.",
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "type": "string",
              "const": "switch_provider"
            }
          },
          "required": [
            "type",
            "session_id",
            "account_id"
          ]
        },
        {
          "description": "Track a pull request for the session.",
          "type": "object",
          "properties": {
            "number": {
              "description": "Number of the pull request in the session's repository.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "session_id": {
              "description": "Target session.",
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "type": "string",
              "const": "link_pr"
            }
          },
          "required": [
            "type",
            "session_id",
            "number"
          ]
        },
        {
          "description": "Stop tracking a pull request for the session.",
          "type": "object",
          "properties": {
            "number": {
              "description": "Number of the pull request in the session's repository.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "session_id": {
              "description": "Target session.",
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "type": "string",
              "const": "unlink_pr"
            }
          },
          "required": [
            "type",
            "session_id",
            "number"
          ]
        },
        {
          "description": "Stop and remove the containers and networks of a Compose project among the session's\ntracked containers; owners only.",
          "type": "object",
          "properties": {
            "project": {
              "description": "Compose project of one of the session's containers.",
              "type": "string"
            },
            "session_id": {
              "description": "Target session.",
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "type": "string",
              "const": "compose_down"
            }
          },
          "required": [
            "type",
            "session_id",
            "project"
          ]
        },
        {
          "description": "Open a shell in the session's worktree and attach to it; owners only.",
          "type": "object",
          "properties": {
            "cols": {
              "description": "Width in columns.",
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "rows": {
              "description": "Height in rows.",
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "session_id": {
              "description": "Target session.",
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "type": "string",
              "const": "open_terminal"
            }
          },
          "required": [
            "type",
            "session_id",
            "cols",
            "rows"
          ]
        },
        {
          "description": "Add an account: run the provider's own login in a fresh config dir, in a login terminal\nthis connection is attached to; owners only. The account joins the account list once\nthe login exits successfully.",
          "type": "object",
          "properties": {
            "account_id": {
              "description": "Id of the new account; unique on this daemon.",
              "$ref": "#/$defs/AccountId"
            },
            "cols": {
              "description": "Width in columns.",
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "config_dir": {
              "description": "Absolute config dir on the host, or one starting with `~/`; the daemon picks one\nin the home directory when absent. It must not hold a login yet.",
              "type": [
                "string",
                "null"
              ]
            },
            "label": {
              "description": "Display label; the id when absent.",
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "description": "Provider to log in to.",
              "$ref": "#/$defs/Provider"
            },
            "rows": {
              "description": "Height in rows.",
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "add_account"
            }
          },
          "required": [
            "type",
            "account_id",
            "provider",
            "cols",
            "rows"
          ]
        },
        {
          "description": "List a folder on the host, to pick a repository; owners only. Answered with\n`directory`. It changes nothing, so a resend is answered afresh.",
          "type": "object",
          "properties": {
            "path": {
              "description": "Absolute path of the folder, or one starting with `~/`.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "list_directory"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "description": "Register a repository on the host as a project, as a `[[project]]` entry of the\ndaemon's config declaring its path; owners only. Answered with `project_added`. A path\ndeclared already is answered with its project.",
          "type": "object",
          "properties": {
            "path": {
              "description": "Absolute path of the repository, or one starting with `~/`.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "add_project"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "description": "Replace a project's settings on this host, kept in its `[[project]]` entry of the\ndaemon's config; owners only. An absent setting is cleared.",
          "type": "object",
          "properties": {
            "default_account": {
              "description": "Account new sessions of the project use when none is given.",
              "anyOf": [
                {
                  "$ref": "#/$defs/AccountId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "default_permission_mode": {
              "description": "Permission mode new sessions of the project start in when none is given.",
              "anyOf": [
                {
                  "$ref": "#/$defs/PermissionMode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "project_id": {
              "description": "The project, one of this daemon's.",
              "$ref": "#/$defs/ProjectId"
            },
            "setup_command": {
              "description": "Shell command run in each new worktree of the project before its session starts.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "set_project_settings"
            }
          },
          "required": [
            "type",
            "project_id"
          ]
        },
        {
          "description": "Stop managing a project on this host; owners only. Answered with `applied`; the\nproject list without it follows. Its clones leave the daemon's `[[project]]` entries\nand are excluded from discovery, until `add_project` adds one again; nothing on disk is\ndeleted. A project with live (not archived) sessions is refused with `conflict`;\narchived ones keep existing without a project.",
          "type": "object",
          "properties": {
            "project_id": {
              "description": "The project, one of this daemon's.",
              "$ref": "#/$defs/ProjectId"
            },
            "type": {
              "type": "string",
              "const": "remove_project"
            }
          },
          "required": [
            "type",
            "project_id"
          ]
        },
        {
          "description": "Start streaming a terminal's output; owners only.",
          "type": "object",
          "properties": {
            "terminal_id": {
              "description": "Target terminal.",
              "$ref": "#/$defs/TerminalId"
            },
            "type": {
              "type": "string",
              "const": "attach_terminal"
            }
          },
          "required": [
            "type",
            "terminal_id"
          ]
        },
        {
          "description": "Stop streaming a terminal's output; the shell keeps running.",
          "type": "object",
          "properties": {
            "terminal_id": {
              "description": "Target terminal.",
              "$ref": "#/$defs/TerminalId"
            },
            "type": {
              "type": "string",
              "const": "detach_terminal"
            }
          },
          "required": [
            "type",
            "terminal_id"
          ]
        },
        {
          "description": "Change a terminal's size.",
          "type": "object",
          "properties": {
            "cols": {
              "description": "Width in columns.",
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "rows": {
              "description": "Height in rows.",
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "terminal_id": {
              "description": "Target terminal.",
              "$ref": "#/$defs/TerminalId"
            },
            "type": {
              "type": "string",
              "const": "resize_terminal"
            }
          },
          "required": [
            "type",
            "terminal_id",
            "cols",
            "rows"
          ]
        },
        {
          "description": "Write bytes to a terminal's input.",
          "type": "object",
          "properties": {
            "data": {
              "description": "Bytes to write.",
              "$ref": "#/$defs/Bytes"
            },
            "terminal_id": {
              "description": "Target terminal.",
              "$ref": "#/$defs/TerminalId"
            },
            "type": {
              "type": "string",
              "const": "terminal_input"
            }
          },
          "required": [
            "type",
            "terminal_id",
            "data"
          ]
        }
      ]
    },
    "CommandId": {
      "description": "Client-chosen idempotency key of a command; a ULID string, opaque to the daemon.",
      "type": "string"
    },
    "Cursor": {
      "description": "A position in a session's journal.",
      "type": "object",
      "properties": {
        "after_seq": {
          "description": "Last event seq the client holds; 0 for none.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "session_id": {
          "description": "The session.",
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "session_id",
        "after_seq"
      ]
    },
    "Image": {
      "description": "An image sent with a prompt.",
      "type": "object",
      "properties": {
        "data": {
          "description": "The image file's bytes, at most [`MAX_IMAGE_BYTES`].",
          "$ref": "#/$defs/Bytes"
        },
        "media_type": {
          "description": "One of [`IMAGE_MEDIA_TYPES`]; the bytes must be an image of that type.",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "data"
      ]
    },
    "PermissionMode": {
      "description": "How much the agent may do without asking.",
      "oneOf": [
        {
          "description": "Reads only; every write or command is refused.",
          "type": "string",
          "const": "read_only"
        },
        {
          "description": "Asks before every write or command.",
          "type": "string",
          "const": "ask"
        },
        {
          "description": "Edits files freely; asks before commands.",
          "type": "string",
          "const": "auto_edit"
        },
        {
          "description": "Does anything without asking.",
          "type": "string",
          "const": "full_access"
        }
      ]
    },
    "ProjectId": {
      "description": "Identifies a project across hosts.\n\nFrom a remote, it is the host and repository path, as in `github.com/org/repo`. For a\nrepository without one, it is the host id and absolute path, as in\n`01J9HOST:/home/dev/scratch`.",
      "type": "string"
    },
    "Provider": {
      "description": "Vendor CLI that runs a session. Open set: accept names not listed in `examples`.",
      "type": "string",
      "examples": [
        "claude",
        "codex",
        "cursor",
        "grok",
        "opencode",
        "gemini"
      ]
    },
    "QuestionId": {
      "description": "Identifies a question within a session; a ULID string, opaque to receivers.",
      "type": "string"
    },
    "SessionId": {
      "description": "Identifies a session; a ULID string, opaque to receivers.",
      "type": "string"
    },
    "TerminalId": {
      "description": "Identifies a terminal on a host; a ULID string, opaque to receivers.",
      "type": "string"
    }
  }
}
