{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RelayHello",
  "description": "First message of a relay connection to the vault.",
  "oneOf": [
    {
      "description": "From a client device: open a stream to a host.",
      "type": "object",
      "properties": {
        "host_id": {
          "description": "The host to reach; one that replicates to this vault.",
          "$ref": "#/$defs/HostId"
        },
        "relay_version": {
          "description": "Must equal the vault's [`RELAY_VERSION`].",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "connect"
        }
      },
      "required": [
        "type",
        "relay_version",
        "host_id"
      ]
    },
    {
      "description": "From a host: this connection is its end of the stream the vault asked it to open.",
      "type": "object",
      "properties": {
        "relay_version": {
          "description": "Must equal the vault's [`RELAY_VERSION`].",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "stream_id": {
          "description": "The stream, as [`crate::VaultMessage::RelayOpen`] named it.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "accept"
        }
      },
      "required": [
        "type",
        "relay_version",
        "stream_id"
      ]
    },
    {
      "description": "From a host: open a stream to the vault's CLIProxyAPI. Only a host the vault told it\nforwards to the proxy ([`crate::VaultHello::cliproxyapi_relay`]) may.",
      "type": "object",
      "properties": {
        "relay_version": {
          "description": "Must equal the vault's [`RELAY_VERSION`].",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "proxy"
        }
      },
      "required": [
        "type",
        "relay_version"
      ]
    }
  ],
  "$defs": {
    "HostId": {
      "description": "Identifies a host running a daemon; a ULID string, opaque to receivers.",
      "type": "string"
    }
  }
}
