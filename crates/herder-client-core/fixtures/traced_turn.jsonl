{"emit": {"type": "turn_started", "turn_id": "turn-1"}}
{"emit": {"type": "item_completed", "item": {"id": "item-1", "turn_id": "turn-1", "body": {"type": "assistant_message", "text": "Hi."}}}}
{"emit": {"type": "turn_completed", "turn_id": "turn-1"}}
