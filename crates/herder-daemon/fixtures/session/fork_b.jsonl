# A fork of the session on another host: the prompt of the turn handed off mid-way runs again on a CLI seeded with the transcript, then the next prompt.
{"expect": {"type": "send_prompt", "turn_id": "b-turn-1", "text": "Second."}}
{"emit": {"type": "turn_started", "turn_id": "b-turn-1"}}
{"emit": {"type": "item_completed", "item": {"id": "item-3", "turn_id": "b-turn-1", "body": {"type": "assistant_message", "text": "Two."}}}}
{"emit": {"type": "turn_completed", "turn_id": "b-turn-1"}}
{"expect": {"type": "send_prompt", "turn_id": "b-turn-2", "text": "Third."}}
{"emit": {"type": "turn_started", "turn_id": "b-turn-2"}}
{"emit": {"type": "item_completed", "item": {"id": "item-4", "turn_id": "b-turn-2", "body": {"type": "assistant_message", "text": "Three."}}}}
{"emit": {"type": "turn_completed", "turn_id": "b-turn-2"}}
