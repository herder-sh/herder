# A session's turn finds its account logged out; once it is logged in again, the failed
# turn's prompt runs on the same CLI.
{"expect": {"type": "send_prompt", "turn_id": "turn-1", "text": "Refactor the parser."}}
{"emit": {"type": "turn_started", "turn_id": "turn-1"}}
{"emit": {"type": "turn_failed", "turn_id": "turn-1", "error": {"class": "auth", "message": "Not logged in · Please run /login"}}}
{"expect": {"type": "send_prompt", "turn_id": "turn-2", "text": "Refactor the parser."}}
{"emit": {"type": "turn_started", "turn_id": "turn-2"}}
{"emit": {"type": "item_completed", "item": {"id": "a-1", "turn_id": "turn-2", "body": {"type": "assistant_message", "text": "Refactored the parser."}}}}
{"emit": {"type": "turn_completed", "turn_id": "turn-2"}}
