# The CLI starts a turn of its own just as the prompt is sent: the adapter holds the prompt
# until that turn ends, then starts the prompt's turn.
{"expect": {"type": "send_prompt", "turn_id": "turn-1", "text": "First."}}
{"emit": {"type": "turn_started", "turn_id": "cli-1"}}
{"emit": {"type": "item_completed", "item": {"id": "item-1", "turn_id": "cli-1", "body": {"type": "assistant_message", "text": "The review finished."}}}}
{"emit": {"type": "turn_completed", "turn_id": "cli-1"}}
{"emit": {"type": "turn_started", "turn_id": "turn-1"}}
{"emit": {"type": "item_completed", "item": {"id": "item-2", "turn_id": "turn-1", "body": {"type": "assistant_message", "text": "One."}}}}
{"emit": {"type": "turn_completed", "turn_id": "turn-1"}}
