# The second session's turn, admitted once the first session's turn ended.
{"expect": {"type": "send_prompt", "turn_id": "turn-2", "text": "Wait your turn."}}
{"emit": {"type": "turn_started", "turn_id": "turn-2"}}
{"emit": {"type": "item_completed", "item": {"id": "item-1", "turn_id": "turn-2", "body": {"type": "assistant_message", "text": "Done."}}}}
{"emit": {"type": "turn_completed", "turn_id": "turn-2"}}
