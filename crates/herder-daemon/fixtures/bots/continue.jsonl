# A thread linked to a session from the app continues it: its reply is the session's prompt.
{"expect": {"type": "send_prompt", "turn_id": "turn-1", "text": "Thanks, now add a test."}}
{"emit": {"type": "turn_started", "turn_id": "turn-1"}}
{"emit": {"type": "item_completed", "item": {"id": "item-1", "turn_id": "turn-1", "body": {"type": "assistant_message", "text": "Added one."}}}}
{"emit": {"type": "turn_completed", "turn_id": "turn-1"}}
