" < back  herder                  inbox 0  +  "
"┌ accounts ────────────────────────────────┐ "
"│ * box  connected - pinned                │ "
"│   Main  claude - claude-main - 4 session │ "
"│     Session          42%                 │ "
"│     #######----------  resets in 2h 13m  │ "
"│     Weekly           74%                 │ "
"│     #############----  resets in 5d 3h   │ "
"│     Weekly - Fable   93%                 │ "
"│     ################-  resets in 5d 3h   │ "
"│   Work  claude - claude-work - failover  │ "
"│     no usage reported yet                │ "
"│   codex  codex                           │ "
"│ ┌ add an account ──────────────────────┐ │ "
"│ │                                      │ │ "
"│ │ Runs the provider's own login on box │ │ "
"│ │                                      │ │ "
"│ │   provider      claude   codex   cur │ │ "
"│ │   id           e.g. work             │ │ "
"│ │   label        the id                │ │ "
"│ │   config dir   ~/.claude-<id>        │ │ "
"│ │                                      │ │ "
"│ │ claude starts: log in with /login, t │ │ "
"│ │ The account is added once the login  │ │ "
"│ │                                      │ │ "
"│ └ field  <> provider  Esc cancel ──────┘ │ "
"│                                          │ "
"│                                          │ "
"│                                          │ "
"│                                          │ "
"│                                          │ "
"│ A session whose account hits a limit     │ "
"│ moves to an account marked failover of   │ "
"│ the same provider, on the same model,    │ "
"│ unless sessions are pinned. Both are set │ "
"│ in the machine's daemon config (failover │ "
"│ = true per account, [failover] pin).     │ "
"└───── n add  r reconnect  Esc close ──────┘ "
" > ok   esc close                            "
" * box  x laptop                     ? help  "
