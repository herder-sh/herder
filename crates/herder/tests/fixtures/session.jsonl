# `herder session` drives this: a reply, then a slow turn that blocks on an approval.
{"emit": {"type": "model_changed", "model": "fake-model-1"}}
{"expect": {"type": "send_prompt", "turn_id": "turn-1", "text": "Say hello."}}
{"emit": {"type": "turn_started", "turn_id": "turn-1"}}
{"emit": {"type": "item_completed", "item": {"id": "item-1", "turn_id": "turn-1", "body": {"type": "assistant_message", "text": "Hello, world."}}}}
{"emit": {"type": "turn_completed", "turn_id": "turn-1"}}
{"expect": {"type": "send_prompt", "turn_id": "turn-2", "text": "Run the tests."}}
{"sleep_ms": 3000}
{"emit": {"type": "turn_started", "turn_id": "turn-2"}}
{"emit": {"type": "item_completed", "item": {"id": "item-2", "turn_id": "turn-2", "body": {"type": "tool_call", "name": "Bash", "input": {"command": "cargo test"}}}}}
{"emit": {"type": "approval_requested", "approval_id": "approval-1", "turn_id": "turn-2", "tool_call_id": "item-2", "summary": "Run cargo test"}}
{"expect": {"type": "answer_approval", "approval_id": "approval-1", "decision": "allow"}}
{"emit": {"type": "item_completed", "item": {"id": "item-3", "turn_id": "turn-2", "body": {"type": "tool_result", "call_id": "item-2", "output": "test result: ok", "is_error": false}}}}
{"emit": {"type": "item_completed", "item": {"id": "item-4", "turn_id": "turn-2", "body": {"type": "assistant_message", "text": "All tests pass."}}}}
{"emit": {"type": "turn_completed", "turn_id": "turn-2"}}
{"expect": {"type": "shutdown"}}
