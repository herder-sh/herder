# The shared widgets, driven by hand: cargo run -p herder-tui --example gallery
# Regenerate: vhs docs/screenshots/p2d-2/gallery.tape (after building the example)
Output docs/screenshots/p2d-2/gallery.gif
Set Shell bash
Set FontSize 15
Set Width 1200
Set Height 640
Set Padding 12
Set Theme { "background": "#111216", "foreground": "#e6e6e6" }
Env COLORTERM truecolor
Hide
Type "clear && target/debug/examples/gallery" Enter
Sleep 1s
Show
Sleep 1s
Type " now" Sleep 600ms
Tab Sleep 500ms
Type "j" Sleep 400ms
Type "j" Sleep 400ms
Type "j" Sleep 600ms
Ctrl+O Sleep 1200ms
Escape Sleep 500ms
Ctrl+T Sleep 1500ms
Ctrl+G Sleep 1500ms
Ctrl+T Sleep 1500ms
Ctrl+G Sleep 500ms
Ctrl+T Sleep 800ms
Hide
Escape
